# Copy to .env for local testing, and add the same keys in Netlify:
# Site configuration → Environment variables.

# The Gmail account that sends the query emails.
GMAIL_USER=debojit.aic@gmail.com
# A 16-character app password for that account: myaccount.google.com/apppasswords
# (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=
# Optional: deliver somewhere other than debojit.aic@gmail.com.
INQUIRY_TO=
